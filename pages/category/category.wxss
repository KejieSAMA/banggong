/* 分类浏览（对应 demo §8）：左栏二级类 + 右侧单列 box */
.cat-layout { flex: 1; display: flex; min-height: 0; }
.cat-rail {
  width: 184rpx; flex-shrink: 0;
  background: var(--surface-container-low);
  height: 100%;
}
.rail-item {
  position: relative; display: flex; align-items: center; justify-content: center;
  text-align: center; height: 104rpx; font-size: 26rpx;
  color: var(--on-surface-variant); width: 100%; padding: 0 16rpx; line-height: 1.35;
}
.rail-item.active { background: var(--surface); color: var(--primary); font-weight: 700; }
.rail-item.active::before {
  content: ""; position: absolute; left: 0; top: 28rpx; bottom: 28rpx;
  width: 7rpx; border-radius: 0 4rpx 4rpx 0; background: var(--primary);
}
.cat-panel { flex: 1; height: 100%; padding: 24rpx 24rpx 48rpx; min-width: 0; }
.cat-sub-hd {
  font-size: 26rpx; font-weight: 700; color: var(--on-surface-variant);
  margin: 4rpx 8rpx 20rpx; display: flex; justify-content: space-between;
}
.cat-grid { display: grid; grid-template-columns: 1fr; gap: 20rpx; }
.cat-box {
  display: flex; align-items: center; gap: 18rpx;
  margin: 0 10rpx;
  background: var(--surface-container-lowest);
  border-radius: var(--shape-md);
  box-shadow: 0 0 0 1rpx var(--outline-variant); /* 0.5px hairline */
  padding: 16rpx; text-align: left;
  animation: staggerIn .3s var(--ease-emph) both;
}
.cat-box .cimg {
  width: 152rpx; height: 152rpx; border-radius: 20rpx;
  overflow: hidden; background: var(--surface-container); flex-shrink: 0;
}
.cat-box .cimg image { width: 100%; height: 100%; }
.cat-box .ctxt { flex: 1; min-width: 0; }
.cat-box .ctxt .nm {
  font-size: 24rpx; line-height: 1.4; color: var(--on-surface); font-weight: 500;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.cat-box .ctxt .pr { font-size: 24rpx; color: var(--price); font-weight: 700; margin-top: 6rpx; }
