/* 首页（对应 demo §6，页内 logo 标题行由原生导航栏替代） */
.home-hero {
  background: linear-gradient(180deg, var(--primary-container) 0%, var(--surface) 100%);
  padding: 28rpx 0 12rpx;
}
.searchbar {
  display: flex; align-items: center; gap: 16rpx;
  margin: 12rpx 28rpx 28rpx; height: 80rpx; padding: 0 28rpx;
  border-radius: 9999rpx; background: var(--surface);
  color: var(--on-surface-variant); font-size: 28rpx;
  box-shadow: var(--elev-1);
}
.searchbar .ph { flex: 1; text-align: left; }

/* 轮播 */
.banner-swiper {
  position: relative; margin: 0 28rpx;
  border-radius: var(--shape-xl); overflow: hidden;
  box-shadow: var(--elev-1); background: var(--surface-container);
}
.bs, .banner-item { width: 100%; height: 264rpx; }
.banner-item { position: relative; overflow: hidden; }
.banner-item image { width: 100%; height: 100%; }
.banner-item::after {
  content: ""; position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background: linear-gradient(90deg, rgba(10,14,40,.62) 0%, rgba(10,14,40,.28) 46%, rgba(10,14,40,0) 78%);
}
.banner-txt { position: absolute; left: 36rpx; top: 50%; transform: translateY(-50%); z-index: 2; color: #fff; }
.banner-txt .t1 { font-size: 38rpx; font-weight: 800; letter-spacing: 1rpx; text-shadow: 0 2rpx 12rpx rgba(0,0,0,.3); }
.banner-txt .t2 {
  font-size: 24rpx; margin-top: 10rpx; opacity: .92;
  display: inline-flex; align-items: center; gap: 10rpx;
}
.banner-txt .t2::before { content: ""; width: 28rpx; height: 3rpx; background: #fff; opacity: .7; }
.banner-dots {
  position: absolute; right: 32rpx; bottom: 20rpx;
  display: flex; gap: 10rpx; z-index: 3;
}
.banner-dots .bd {
  width: 12rpx; height: 12rpx; border-radius: 6rpx;
  background: rgba(255,255,255,.55);
  transition: all var(--dur-m);
}
.banner-dots .bd.on { width: 32rpx; background: #fff; }

/* 快捷导航（6 宫格） */
.quick-nav { display: grid; grid-template-columns: repeat(6, 1fr); padding: 36rpx 12rpx 8rpx; }
.qn-item {
  display: flex; flex-direction: column; align-items: center; gap: 14rpx;
  border-radius: var(--shape-md);
}
.qn-ic {
  width: 92rpx; height: 92rpx; border-radius: 32rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--surface-container); color: var(--primary);
}
.qn-lb { font-size: 23rpx; color: var(--on-surface); font-weight: 500; }
