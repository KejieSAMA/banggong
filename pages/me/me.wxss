/* 我的页（对应 demo §11；顶部内边距因原生导航栏而缩小） */
.me-head {
  position: relative; padding: 44rpx 40rpx 0; overflow: hidden;
  background: linear-gradient(165deg, var(--primary) 0%, var(--primary-container) 130%);
}
.me-head::after {
  content: ""; position: absolute; right: -92rpx; top: -92rpx;
  width: 380rpx; height: 380rpx; border-radius: 50%;
  background: rgba(255,255,255,.09);
}
.me-head::before {
  content: ""; position: absolute; right: 52rpx; top: 128rpx;
  width: 128rpx; height: 128rpx; border-radius: 50%;
  background: rgba(255,255,255,.08);
}
.me-user {
  display: flex; align-items: center; gap: 28rpx;
  position: relative; z-index: 2; padding-bottom: 36rpx;
}
.avatar {
  width: 124rpx; height: 124rpx; border-radius: 50%;
  background: var(--surface-container-highest);
  display: flex; align-items: center; justify-content: center;
  color: var(--on-surface-variant);
  border: 5rpx solid rgba(255,255,255,.75); flex-shrink: 0;
}
.me-user-info { flex: 1; min-width: 0; }
.me-name { color: #fff; font-size: 38rpx; font-weight: 700; display: flex; align-items: center; gap: 12rpx; }
.me-vip {
  display: inline-flex; align-items: center; gap: 6rpx;
  font-size: 21rpx; font-weight: 600; color: #fff;
  background: rgba(255,255,255,.22);
  padding: 5rpx 18rpx; border-radius: 18rpx; margin-top: 12rpx;
}
.me-stats {
  display: flex; background: rgba(255,255,255,.13);
  border-radius: var(--shape-lg) var(--shape-lg) 0 0;
  position: relative; z-index: 2;
}
.me-stat {
  flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4rpx;
  padding: 28rpx 0 26rpx; color: #fff;
}
.me-stat .n { font-size: 38rpx; font-weight: 800; }
.me-stat .t { font-size: 23rpx; opacity: .85; }
.hv-stat { background: rgba(255,255,255,.1); }

.me-grid { display: grid; grid-template-columns: repeat(2, 1fr); padding: 32rpx 16rpx 8rpx; }
.me-g-it {
  display: flex; flex-direction: column; align-items: center; gap: 16rpx;
  padding: 16rpx 0; border-radius: var(--shape-md);
}
.me-g-it icon { color: var(--primary); }
.me-g-it text { font-size: 23rpx; color: var(--on-surface); }
.me-srv-hd {
  font-size: 30rpx; font-weight: 700; padding: 24rpx 36rpx 8rpx;
  display: flex; align-items: center; gap: 14rpx;
}
.me-srv-hd::before { content: ""; width: 8rpx; height: 30rpx; border-radius: 4rpx; background: var(--primary); }
.srv-group { margin-top: 16rpx; }

/* 头像展示 */
.avatar-img { width: 100%; height: 100%; border-radius: 50%; }

/* 资料编辑表单（sheet 插槽，页面作用域） */
.profile-form { padding: 16rpx 44rpx 8rpx; display: flex; flex-direction: column; align-items: center; }
.avatar-btn {
  display: flex; flex-direction: column; align-items: center; gap: 12rpx;
  background: none; border: none; padding: 0; margin: 0; line-height: inherit;
}
.avatar-btn::after { border: none; }
.avatar-btn-img,
.avatar-btn-holder {
  width: 140rpx; height: 140rpx; border-radius: 50%; overflow: hidden;
  background: var(--surface-container-high);
  display: flex; align-items: center; justify-content: center;
  color: var(--on-surface-variant);
}
.avatar-btn-img { border: 4rpx solid var(--outline-variant); }
.avatar-btn-tip { font-size: 22rpx; color: var(--on-surface-variant); }
.nick-row {
  width: 100%; display: flex; align-items: center; gap: 24rpx;
  margin: 32rpx 0 8rpx; padding: 16rpx 24rpx;
  background: var(--surface-container);
  border-radius: var(--shape-md);
}
.nick-row .lab { font-size: 28rpx; color: var(--on-surface-variant); flex-shrink: 0; }
.nick-input { flex: 1; font-size: 28rpx; color: var(--on-surface); }
.s-ph { color: var(--on-surface-variant); opacity: .8; }
.profile-form .sheet-btns { width: 100%; }

/* 头像压缩离屏画布：不占版面，仅提供 canvas 节点 */
.avatar-canvas {
  position: fixed; left: -9999px; top: -9999px;
  width: 128px; height: 128px;
}

/* 一键登录 sheet */
.login-form {
  padding: 24rpx 44rpx 8rpx;
  display: flex; flex-direction: column; align-items: center;
}
.login-logo {
  width: 140rpx; height: 140rpx; border-radius: 44rpx;
  background: var(--primary-container);
  color: var(--on-primary-container);
  display: flex; align-items: center; justify-content: center;
}
.login-tit { margin-top: 28rpx; font-size: 32rpx; font-weight: 700; color: var(--on-surface); }
.login-form .sheet-btns { width: 100%; margin-top: 36rpx; }

/* 隐私协议勾选行 */
.privacy-row {
  display: flex; align-items: center; gap: 12rpx;
  margin-top: 28rpx; padding-bottom: 8rpx;
}
.privacy-check {
  position: relative;
  width: 34rpx; height: 34rpx; border-radius: 8rpx;
  border: 2rpx solid var(--outline);
  background: var(--surface);
  flex-shrink: 0;
}
.privacy-check.on { background: var(--primary); border-color: var(--primary); }
/* 纯 CSS 对勾（图标库无单独 check 线性图标） */
.privacy-check.on::after {
  content: ""; position: absolute; left: 50%; top: 50%;
  width: 16rpx; height: 9rpx;
  border-left: 4rpx solid #fff; border-bottom: 4rpx solid #fff;
  transform: translate(-50%, -65%) rotate(-45deg);
}
.privacy-txt { font-size: 22rpx; color: var(--on-surface-variant); line-height: 1.5; }
.privacy-link { color: var(--primary); }
