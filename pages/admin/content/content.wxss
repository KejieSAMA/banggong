/* 内容管理（Banner / 热搜词） */
.ct-hd {
  font-size: 30rpx; font-weight: 700; color: var(--on-surface);
  padding: 28rpx 32rpx 8rpx;
  display: flex; align-items: center; gap: 14rpx;
}
.ct-hd::before { content: ""; width: 8rpx; height: 30rpx; border-radius: 4rpx; background: var(--primary); }

.ct-banner {
  display: flex; gap: 20rpx;
  margin: 16rpx 24rpx 0; padding: 20rpx;
  background: var(--surface-container-low);
  border-radius: var(--shape-lg);
}
.ct-b-thumb {
  position: relative; width: 220rpx; height: 140rpx;
  border-radius: var(--shape-md); overflow: hidden;
  background: var(--surface-container-high); flex-shrink: 0;
}
.ct-b-thumb image { width: 100%; height: 100%; }
.ct-b-holder {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  color: var(--on-surface-variant); font-size: 20rpx;
  border: 2rpx dashed var(--outline-variant); box-sizing: border-box;
}
.ct-b-fields { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 14rpx; }
.ct-b-input {
  height: 64rpx; line-height: 64rpx; padding: 0 20rpx;
  border-radius: var(--shape-sm); background: var(--surface-container);
  font-size: 25rpx; color: var(--on-surface);
}
.ct-b-del {
  align-self: flex-start;
  font-size: 22rpx; font-weight: 600; color: var(--error, #B3261E);
  padding: 6rpx 0;
}
.ct-add-banner {
  margin: 16rpx 24rpx 0; padding: 22rpx;
  text-align: center; font-size: 26rpx; font-weight: 600;
  color: var(--primary);
  background: var(--surface-container-low);
  border: 2rpx dashed var(--outline-variant); border-radius: var(--shape-lg);
  box-sizing: border-box;
}

.ct-words {
  display: flex; flex-wrap: wrap; gap: 16rpx;
  padding: 12rpx 24rpx 0;
}
.ct-word {
  display: flex; align-items: center; gap: 8rpx;
  padding: 10rpx 12rpx 10rpx 22rpx;
  background: var(--surface-container);
  border-radius: 999rpx;
  font-size: 24rpx; color: var(--on-surface);
}
.ct-word-x {
  width: 36rpx; height: 36rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%; background: var(--surface-container-high);
  color: var(--on-surface-variant);
}
.ct-word-row {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 24rpx 0;
}
.ct-word-input {
  flex: 1; height: 72rpx; line-height: 72rpx; padding: 0 24rpx;
  border-radius: 999rpx; background: var(--surface-container);
  font-size: 26rpx; color: var(--on-surface);
}
.ct-word-add {
  padding: 16rpx 36rpx; border-radius: 999rpx;
  background: var(--primary); color: var(--on-primary);
  font-size: 26rpx; font-weight: 600; flex-shrink: 0;
}

.ct-foot { padding: 36rpx 24rpx 60rpx; }
.ct-tip { text-align: center; font-size: 22rpx; color: var(--on-surface-variant); margin-top: 16rpx; }
.s-ph { color: var(--on-surface-variant); opacity: .8; }
.btn.disabled { opacity: .6; pointer-events: none; }

.banner-canvas {
  position: fixed; left: -9999px; top: -9999px;
  width: 1200px; height: 1200px;
}
