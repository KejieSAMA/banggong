<view class="page {{theme}}">
  <view class="page-body">
    <view class="cat-bar">
      <text class="cat-tip">共 {{list.length}} 个分类</text>
      <view class="cat-add" hover-class="hv-sink" hover-stay-time="80" bindtap="openCreate">
        <icon name="edit" size="36" />新增分类
      </view>
    </view>

    <view wx:for="{{list}}" wx:key="id" class="cat-row">
      <view class="cat-ic"><icon name="{{item.icon}}" size="44" /></view>
      <view class="cat-info">
        <view class="cat-name">{{item.name}}</view>
        <view class="cat-sub">{{item.subText}}</view>
      </view>
      <view class="cat-count">{{item.count}} 件</view>
      <view class="cat-acts">
        <view class="cat-mini" hover-class="hv-cell" hover-stay-time="80" data-id="{{item.id}}" catchtap="openEdit">编辑</view>
        <view class="cat-mini danger" hover-class="hv-cell" hover-stay-time="80" data-id="{{item.id}}" catchtap="onOpenDelete">删除</view>
      </view>
    </view>
    <view style="height:40rpx" />
  </view>

  <!-- 新增 / 编辑 sheet -->
  <sheet visible="{{editVisible}}" title="{{editTitle}}" bind:close="onEditClose">
    <view class="cedit-form">
      <view class="cedit-row">
        <text class="lab">名称</text>
        <input class="cedit-input" value="{{draftName}}" bindinput="onNameInput"
          placeholder="如：办公文具" placeholder-class="s-ph" maxlength="32" />
      </view>
      <view class="cedit-row">
        <text class="lab">图标</text>
        <picker class="cedit-input" range="{{iconLabels}}" value="{{iconIdx}}" bindchange="onIconChange">
          <view class="cedit-picker"><icon name="{{iconLabels[iconIdx]}}" size="40" /> {{iconLabels[iconIdx]}}</view>
        </picker>
      </view>
      <view class="cedit-hd">
        <text class="lab">二级分类（最多 8 个）</text>
        <view class="cedit-add" hover-class="hv-cell" hover-stay-time="80" bindtap="onSubAdd">+ 添加</view>
      </view>
      <view wx:for="{{subs}}" wx:key="index" class="cedit-sub-row">
        <input class="cedit-input sub" value="{{item}}" data-i="{{index}}" bindinput="onSubInput"
          placeholder="如：中性笔" placeholder-class="s-ph" maxlength="16" />
        <view class="cedit-sub-del" hover-class="hv-cell" hover-stay-time="80" data-i="{{index}}" bindtap="onSubRemove">
          <icon name="close" size="28" />
        </view>
      </view>
      <view class="sheet-btns">
        <view class="btn btn-filled btn-block {{saving ? 'disabled' : ''}}" hover-class="hv-sink" hover-stay-time="80" bindtap="onSave">
          {{saving ? '保存中…' : '保存'}}
        </view>
      </view>
    </view>
  </sheet>

  <dialog
    visible="{{delVisible}}"
    title="删除分类"
    content="删除后不可恢复（分类下有商品时会被拒绝），确定删除该分类吗？"
    actions="{{delActions}}"
    bind:close="onDeleteClose"
    bind:action="onDeleteAction"
  />
  <toast id="toast" />
</view>
