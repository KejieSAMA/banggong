/* 商品编辑表单 */
.fm-group {
  margin: 20rpx 24rpx 0; padding: 8rpx 28rpx;
  background: var(--surface-container-low);
  border-radius: var(--shape-lg);
}
.fm-label {
  font-size: 25rpx; color: var(--on-surface-variant);
  padding: 20rpx 0 8rpx; display: block;
}
.fm-row {
  display: flex; align-items: center; gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--outline-variant);
}
.fm-group .fm-row:last-child { border-bottom: none; }
.fm-row .fm-label { padding: 0; width: 150rpx; flex-shrink: 0; }
.fm-input { flex: 1; font-size: 28rpx; color: var(--on-surface); }
.fm-picker { font-size: 28rpx; color: var(--on-surface); }
.s-ph { color: var(--on-surface-variant); opacity: .8; }

/* 图集宫格：3 列，首张带「主图」徽标，每张可删 */
.fm-imgs {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx;
  padding: 8rpx 0 28rpx;
}
.fm-img-cell {
  position: relative; width: 100%; padding-bottom: 100%;
  border-radius: var(--shape-md); overflow: hidden;
  background: var(--surface-container-high);
}
.fm-img-cell .fm-img-in {
  position: absolute; left: 0; top: 0; width: 100%; height: 100%;
}
.fm-img-main {
  position: absolute; left: 0; top: 0;
  background: var(--primary); color: var(--on-primary);
  font-size: 18rpx; font-weight: 700; line-height: 1;
  padding: 6rpx 10rpx; border-radius: 0 0 var(--shape-md) 0;
}
.fm-img-del {
  position: absolute; right: 0; bottom: 0;
  width: 44rpx; height: 44rpx;
  display: flex; align-items: center; justify-content: center;
  background: rgba(0,0,0,.5); color: #fff;
  border-radius: var(--shape-md) 0 0 0;
}
.fm-img-add {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  color: var(--on-surface-variant); font-size: 22rpx; gap: 8rpx;
  border: 2rpx dashed var(--outline-variant);
}

/* 简介 */
.fm-textarea {
  width: 100%; min-height: 160rpx; font-size: 27rpx; color: var(--on-surface);
  padding-bottom: 24rpx; box-sizing: border-box;
}

/* 规格编辑器 */
.fm-specs-hd {
  display: flex; align-items: center; justify-content: space-between;
}
.fm-spec-add {
  font-size: 24rpx; font-weight: 600; color: var(--primary);
  padding: 16rpx 0 8rpx;
}
.fm-spec-row {
  display: flex; align-items: center; gap: 14rpx;
  padding: 12rpx 0;
}
/* 固定高度+行高：原生 input 无固定行盒会被容器裁底（全局 border-box） */
.fm-spec-k,
.fm-spec-v {
  height: 64rpx; line-height: 64rpx; padding: 0 18rpx;
  border-radius: var(--shape-sm);
  background: var(--surface-container); font-size: 25rpx; color: var(--on-surface);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.fm-spec-k { width: 200rpx; flex-shrink: 0; }
.fm-spec-v { flex: 1; min-width: 0; }
.fm-spec-del {
  flex-shrink: 0; width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%; color: var(--on-surface-variant);
  background: var(--surface-container);
}

.fm-foot { padding: 36rpx 24rpx 60rpx; }
.btn.disabled { opacity: .6; pointer-events: none; }

/* 压缩离屏画布 */
.edit-canvas {
  position: fixed; left: -9999px; top: -9999px;
  width: 800px; height: 800px;
}
