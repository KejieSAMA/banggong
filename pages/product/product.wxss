/* 商品详情（对应 demo §9；导航栏由原生承载） */
.dtl-hero {
  position: relative; height: 600rpx; overflow: hidden;
  background: var(--surface-container);
}
.dtl-swiper, .dtl-swiper image { width: 100%; height: 600rpx; }
.dtl-dots {
  position: absolute; bottom: 24rpx; left: 50%; transform: translateX(-50%);
  display: flex; gap: 10rpx; z-index: 3;
}
.dtl-dots .dd {
  width: 12rpx; height: 12rpx; border-radius: 6rpx;
  background: rgba(255,255,255,.6);
  transition: all var(--dur-m);
}
.dtl-dots .dd.on { width: 34rpx; background: #fff; }
.dtl-idx {
  position: absolute; right: 24rpx; bottom: 24rpx; z-index: 3;
  background: rgba(0,0,0,.4); color: #fff;
  font-size: 22rpx; padding: 4rpx 18rpx; border-radius: 20rpx;
}

.dtl-sec { background: var(--surface); padding: 32rpx 32rpx 12rpx; }
.sec-pad { padding-bottom: 20rpx; }
.sec-pad2 { padding-bottom: 32rpx; }
.dtl-price-row { display: flex; align-items: baseline; gap: 18rpx; }
.price.big { font-size: 48rpx; }
.price.big .num { font-size: 60rpx; }
.dtl-meta { font-size: 24rpx; color: var(--on-surface-variant); }
.dtl-meta.right { margin-left: auto; }
.dtl-meta.rate { display: inline-flex; align-items: center; gap: 6rpx; }
.dtl-name { font-size: 36rpx; font-weight: 700; line-height: 1.5; margin-top: 16rpx; }
.dtl-tags { display: flex; gap: 14rpx; margin-top: 20rpx; }
.dtl-tags .tag { height: 40rpx; font-size: 22rpx; border-radius: 10rpx; }
.tag-ship { background: var(--tertiary-container); color: var(--on-primary-container); }
.dark .tag-ship { color: var(--tertiary); }
.tag-plain { background: var(--surface-container); color: var(--on-surface-variant); }

.section-hd.plain { padding: 4rpx 0 4rpx; }

.specs-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 6rpx 24rpx; margin-top: 20rpx;
  background: var(--surface);
}
.spec-it { display: flex; gap: 16rpx; font-size: 26rpx; padding: 10rpx 0; }
.spec-it .k { color: var(--on-surface-variant); flex-shrink: 0; width: 124rpx; }
.spec-it .v { color: var(--on-surface); font-weight: 500; }

.dtl-desc-p {
  font-size: 27rpx; line-height: 1.85;
  color: var(--on-surface-variant); margin-top: 16rpx;
  display: block;
}
.dtl-fakeimg {
  margin-top: 28rpx; border-radius: var(--shape-md); height: 300rpx;
  background: linear-gradient(135deg, var(--surface-container) 0%, var(--surface-container-high) 45%, var(--surface-container-low) 100%);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 20rpx;
  color: var(--on-surface-variant);
}
.dtl-fakeimg icon { opacity: .4; }
.dtl-fakeimg text { font-size: 24rpx; letter-spacing: 4rpx; opacity: .7; }

/* 底部操作栏：固定 + 安全区 */
.dtl-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
  display: flex; align-items: center; gap: 8rpx;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--surface-container);
  border-top: 2rpx solid var(--outline-variant);
}
.dtl-act {
  flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4rpx;
  color: var(--on-surface-variant); font-size: 21rpx;
  border-radius: 20rpx; padding: 6rpx 12rpx;
}
.dtl-act.on { color: var(--price); }
.dtl-buy {
  margin-left: 16rpx; height: 84rpx; padding: 0 52rpx; border-radius: 42rpx;
  background: var(--primary); color: var(--on-primary);
  font-size: 30rpx; font-weight: 700;
  display: flex; align-items: center; gap: 16rpx;
}

/* open-type=share 的原生 button 重置为分享宫格样式 */
.share-btn-reset {
  padding: 0; margin: 0; background: none; border: none; line-height: inherit;
  font-size: inherit;
}
.share-btn-reset::after { border: none; }
